{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "CommonJS", "moduleResolution": "Node", "ignoreDeprecations": "6.0",
    "rootDir": "..", "outDir": "lib", "strict": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
