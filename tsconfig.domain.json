{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "types": [], "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/modules/**/*.ts", "src/shared/domain/**/*.ts"],
  "exclude": ["src/modules/**/*.test.ts", "src/modules/**/tests/**"]
}
