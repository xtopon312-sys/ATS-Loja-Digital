{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"], "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/infrastructure/firebase/**/*.ts", "src/modules/auth/**/*.ts", "src/shared/domain/**/*.ts"]
}
